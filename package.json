{
  "name": "freelancr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx lib/db/migrate.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test \"lib/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:push": "tsx scripts/require-dev-db.ts && drizzle-kit push",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/require-dev-db.ts && node --env-file=.env.local --import tsx lib/db/migrate.ts",
    "db:seed": "node --env-file=.env.local --import tsx scripts/seed-demo.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "demo:record": "tsx scripts/record-demo.mts",
    "backup": "node --env-file=${BACKUP_ENV:-.env.local} --import tsx scripts/restore-backup.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@neondatabase/serverless": "^1.0.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-pdf/renderer": "^4.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.2.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "nanoid": "^5.1.11",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "puppeteer-core": "^25.18.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5"
  }
}
