# Required in production — generate with: openssl rand -base64 32
SESSION_SECRET=

# Neon Postgres (Vercel Marketplace: vercel integration add neon)
DATABASE_URL=

# Email (optional). Without RESEND_API_KEY and MAIL_FROM the app runs with
# email off: no password reset emails, no invoices sent to clients, no
# deadline reminders, and the pages say so.
# Resend API key (https://resend.com), with a domain verified there.
RESEND_API_KEY=
# The sender, "Name <address@your-verified-domain>". Invoice emails keep the
# address and use "<your business name> via Freelancr" as the name.
MAIL_FROM=
# Base URL for links in emails, e.g. https://your-domain. Defaults to
# https://$VERCEL_PROJECT_PRODUCTION_URL on Vercel.
APP_URL=
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/daily;
# anything else gets a 401. Generate with: openssl rand -base64 32
CRON_SECRET=
